# Supabase: kraftzen-blog project (org officialkraftzen@gmail.com, region ap-south-1)
#
# The publishable key is designed to be exposed in the browser bundle. It is not
# a secret. What protects the data is row level security, which is on for every
# table. Never put the service_role key in here: this file is bundled by Vite.
VITE_SUPABASE_URL=https://uqnjbkxwmoaohgvwvozl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fjXZeKfq-_cfsdkClJhlkg_DIthuxjm
VITE_SUPABASE_PROJECT_ID=uqnjbkxwmoaohgvwvozl

# Optional. If your host exposes a build hook URL, the admin Publish button
# pings it so prerendered post HTML gets regenerated. Leave blank to skip.
VITE_DEPLOY_HOOK_URL=

# The daily blog idea research routine on claude.ai. The admin Ideas tab links
# here so you can fire it on demand instead of waiting for 8am.
# Not a secret: it is just a page URL, and the page itself is behind your login.
VITE_IDEAS_ROUTINE_URL=https://claude.ai/code/routines/trig_01Gc968ffsiNH5odytjA2G64
