# Copy to .env and fill in. All VITE_ vars are bundled into the client, so only
# ever put publishable values here. The service_role key does not belong in this
# file or anywhere else in this repo.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Optional build hook, pinged by the admin Publish button so prerendered post
# HTML is regenerated. Safe to leave blank.
VITE_DEPLOY_HOOK_URL=

# Optional. The claude.ai routine that researches blog ideas each morning. The
# admin Ideas tab shows a "Run research now" button when this is set.
VITE_IDEAS_ROUTINE_URL=https://claude.ai/code/routines/<routine-id>
